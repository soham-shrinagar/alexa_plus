generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) externalUserId String @unique preferences UserPreference[] calendarEvents CalendarEvent[] tasks Task[] notifications Notification[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model UserPreference { id String @id @default(cuid()) userId String key String value Json user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([userId, key]) }
model CalendarEvent { id String @id @default(cuid()) userId String externalId String? title String startTime DateTime endTime DateTime location String? user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId, startTime]) }
model Task { id String @id @default(cuid()) userId String title String description String? dueAt DateTime? status String @default("open") user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([userId, dueAt]) }
model Notification { id String @id @default(cuid()) userId String message String scheduledAt DateTime status String @default("scheduled") idempotencyKey String? user User @relation(fields: [userId], references: [id], onDelete: Cascade) createdAt DateTime @default(now()) @@unique([userId, idempotencyKey]) @@index([userId, scheduledAt]) }
model ToolExecutionLog { id String @id @default(cuid()) requestId String userId String? toolName String status String latencyMs Int createdAt DateTime @default(now()) @@index([requestId]) }
model AuditLog { id String @id @default(cuid()) requestId String userId String? action String toolName String? status String createdAt DateTime @default(now()) @@index([userId, createdAt]) }
