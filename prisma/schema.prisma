generator client {
  provider = "prisma-client-js"
  output   = "../apps/mcp-server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  externalUserId String @unique
  preferences UserPreference[]
  calendarEvents CalendarEvent[]
  tasks Task[]
  notifications Notification[]
  memories EpisodicMemory[]
  workflows Workflow[]
  approvals Approval[]
  monitoredPlans MonitoredPlan[]
  rehearseProposals RehearseProposal[]
  rehearseSimulations RehearseSimulation[]
  rehearseActivations RehearseActivation[]
  rehearseAuditEvents RehearseAuditEvent[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model UserPreference {
  id String @id @default(cuid())
  userId String
  key String
  value Json
  source String @default("explicit")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@unique([userId, key])
}

model CalendarEvent {
  id String @id @default(cuid())
  userId String
  externalId String?
  title String
  startTime DateTime @db.Timestamptz(6)
  endTime DateTime @db.Timestamptz(6)
  location String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@index([userId, startTime])
}

model Task {
  id String @id @default(cuid())
  userId String
  title String
  description String?
  dueAt DateTime? @db.Timestamptz(6)
  status String @default("open")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@index([userId, dueAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  message String
  scheduledAt DateTime @db.Timestamptz(6)
  status String @default("scheduled")
  idempotencyKey String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([userId, idempotencyKey])
  @@index([userId, scheduledAt])
}

model ToolExecutionLog {
  id String @id @default(cuid())
  requestId String
  userId String?
  toolName String
  status String
  latencyMs Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([requestId])
}

model AuditLog {
  id String @id @default(cuid())
  requestId String
  userId String?
  action String
  toolName String?
  status String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([userId, createdAt])
}

model EpisodicMemory {
  id String @id @default(cuid())
  userId String
  category String
  summary String
  referenceType String?
  referenceId String?
  source String
  retentionUntil DateTime? @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@index([userId, category, createdAt])
}

model Workflow {
  id String @id @default(cuid())
  userId String
  type String
  status String
  currentStep String?
  idempotencyKey String?
  approvalStatus String @default("NOT_REQUIRED")
  retryCount Int @default(0)
  deadlineAt DateTime? @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  steps WorkflowStep[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
}

model WorkflowStep {
  id String @id @default(cuid())
  workflowId String
  stepKey String
  status String
  dependsOn Json
  input Json?
  result Json?
  errorCode String?
  retryCount Int @default(0)
  startedAt DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([workflowId, stepKey])
  @@index([workflowId, status])
}

model Approval {
  id String @id @default(cuid())
  userId String
  actionType String
  payloadHash String
  status String @default("PENDING")
  expiresAt DateTime @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([userId, status, expiresAt])
}

model MonitoredPlan {
  id String @id @default(cuid())
  userId String
  workflowId String?
  eventId String?
  origin String
  destination String
  baselineTravelMinutes Int
  thresholdMinutes Int @default(10)
  enabled Boolean @default(true)
  quietHours Json?
  lastNotificationFingerprint String?
  nextCheckAt DateTime? @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@index([enabled, nextCheckAt])
}

model BackgroundJob {
  id String @id @default(cuid())
  type String
  status String @default("PENDING")
  payload Json
  attempts Int @default(0)
  maxAttempts Int @default(3)
  runAt DateTime @db.Timestamptz(6)
  lastErrorCode String?
  lockedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  @@index([status, runAt])
}

model ProviderHealth {
  provider String @id
  state String @default("CLOSED")
  consecutiveFailures Int @default(0)
  openedAt DateTime? @db.Timestamptz(6)
  lastFailureAt DateTime? @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model RehearseProposal {
  id String @id @default(cuid())
  userId String
  scenarioId String
  goal String
  status String @default("DRAFT")
  version Int @default(1)
  routine Json
  microTwin Json
  context Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulations RehearseSimulation[]
  activations RehearseActivation[]
  auditEvents RehearseAuditEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status, createdAt])
}

model RehearseSimulation {
  id String @id @default(cuid())
  userId String
  proposalId String
  proposalVersion Int
  status String
  violations Json
  trace Json
  summary Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal RehearseProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, proposalId, createdAt])
}

model RehearseActivation {
  id String @id @default(cuid())
  userId String
  proposalId String
  proposalVersion Int
  status String @default("ACTIVE")
  snapshot Json
  runtimeState Json
  idempotencyKey String?
  activatedAt DateTime @default(now())
  rolledBackAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal RehearseProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  auditEvents RehearseAuditEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, idempotencyKey])
  @@index([userId, proposalId, status])
}

model RehearseAuditEvent {
  id String @id @default(cuid())
  userId String
  proposalId String?
  activationId String?
  type String
  details Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal RehearseProposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  activation RehearseActivation? @relation(fields: [activationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, proposalId, createdAt])
}

model AutomationAccount {
  id String @id @default(uuid())
  username String @unique
  salt String
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model AutomationWorkspace {
  id String @id @default(uuid())
  ownerId String
  revision Int @default(1)
  document Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([ownerId, updatedAt])
}
