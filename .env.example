PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
DEMO_MODE=true
# This example deliberately uses memory. Remove this line or set prisma to use Neon.
# With no explicit mode, DATABASE_URL selects Prisma; no URL selects memory.
REPOSITORY_MODE=memory
AUTH_REQUIRED=true
# Set this to a strong secret outside demo mode; never commit its value.
JWT_SECRET=
ALLOWED_ORIGINS=
# Uncomment only after supplying an actual connection string; never commit it.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rehearse
# Run the opt-in persistence suite only with an isolated, disposable database URL.
# RUN_NEON_INTEGRATION=true
# JSON supplied by your secret manager, never committed. Example shape only:
# OAUTH_CLIENTS_JSON=[{"id":"alexa-client-id","secret":"from-secret-manager","redirectUris":["https://client.example/callback"]}]
OAUTH_CLIENTS_JSON=

# Gemini stays server-side. Generate/rotate your key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=45000
# Open-Meteo weather needs no API key for non-commercial use.
# TomTom key with Geocoding and Routing access. Select locations in the planner.
TOMTOM_API_KEY=
# Amazon preview currently requires no WWW-Authenticate challenge header.
# Keep false for standard MCP clients; true only for authorized Alexa testing.
ALEXA_AUTH_COMPATIBILITY=false
