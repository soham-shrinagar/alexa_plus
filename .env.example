PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
DEMO_MODE=true
# Use memory for deterministic local demos. Production must use prisma.
REPOSITORY_MODE=memory
AUTH_REQUIRED=true
# Set this to a strong secret outside demo mode; never commit its value.
JWT_SECRET=
ALLOWED_ORIGINS=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rehearse
# Run the opt-in persistence suite only with an isolated, disposable database URL.
# RUN_NEON_INTEGRATION=true
# JSON supplied by your secret manager, never committed. Example shape only:
# OAUTH_CLIENTS_JSON=[{"id":"alexa-client-id","secret":"from-secret-manager","redirectUris":["https://client.example/callback"]}]
OAUTH_CLIENTS_JSON=
