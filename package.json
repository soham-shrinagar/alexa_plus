{
  "name": "rehearse-alexa-plus",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "setup": "node scripts/setup.js",
    "test": "npm --prefix apps/mcp-server test",
    "check": "node scripts/check.js",
    "test:automation": "node --test apps/mcp-server/test/automation/*.test.js",
    "automation:import": "node apps/mcp-server/scripts/automationCli.js import",
    "automation:ha-cases": "node apps/mcp-server/scripts/haCases.js",
    "automation:evaluate": "node apps/mcp-server/scripts/evaluateAutomation.js",
    "check:release": "node scripts/automationReleaseCheck.js",
    "check:automation-config": "node scripts/automationConfigCheck.js",
    "test:neon": "npm --prefix apps/mcp-server run test:neon",
    "smoke:providers": "node scripts/providerSmoke.js",
    "smoke:journey": "node scripts/providerSmoke.js --journey",
    "check:alexa": "node scripts/alexaReadiness.js",
    "prisma:validate": "node scripts/prismaValidate.js",
    "prisma:generate": "node scripts/prisma.js generate",
    "prisma:migrate": "node scripts/prisma.js migrate deploy",
    "prisma:status": "node scripts/prisma.js migrate status"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" }
  }
}
